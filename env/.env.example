# Application URLs
APP_URL=https://your-app-url.com
API_URL=https://your-api-url.com

# Administrator credentials -- the account auth.setup.ts builds storage state from
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Optional: utility / helper service, read by config/util/util.ts.
# Leave commented out unless a utility service is in use.
# UTILITY_URL=https://your-utility-service.com
